	quest.6B65DF5DA353CA24.quest_desc: [
		"&7A &b&lKlein Star&r&7 - a portable EMC battery - of size &fDrei&7: it holds &f800 000&7 EMC."
		"&7ProjectE tools, rings and amulets draw their EMC from the stars in your inventory. A star is filled from your own EMC in the Transmutation Table: with generation disabled, it only ever holds what you burned."
		""
		"&7Unlocks the &b&lLight Blue Ticket&r&7 and the &fLight Blue Egg [MK 8]&7 - see &6JEI&7."
	]
	quest.6B65DF5DA353CA24.quest_subtitle: "&7Tier 8 &8- &bLight Blue Ticket"
	quest.6B65DF5DA353CA24.title: "&b&lKlein Star Drei"
