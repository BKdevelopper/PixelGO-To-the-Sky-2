	quest.3FA19479EFE7B368.quest_desc: [
		"&e&lEV TRAINING &8- &730 min, every difficulty"
		"&7&l- &fStrength&7 (Attack), &fGuard&7 (Defence), &fSpeed&7, &fEndurance&7 (HP)"
