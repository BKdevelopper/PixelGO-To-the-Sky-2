	quest.60542DE7B1C71E7A.quest_desc: ["&7The rarest of them all: it is crafted (see &bJEI&7) or earned - the &e&lPokédex&r&7 at 100% and the &8&lSoul Sand Trophy&r&7 each give one. No chest or bag holds it any more."]
	quest.60542DE7B1C71E7A.title: "{quest.minions.title.25}"
	quest.606F03FBFD2502C5.quest_desc: ["{quest.minions.description.7}"]
	quest.606F03FBFD2502C5.title: "{quest.minions.title.8}"
	quest.6096808D07872933.quest_desc: [
		"&7&o\"...That is it, then. Every tower, every Champion, and now me. Take the trophy. It was always going to have your name on it.\""
		""
		"&7Beat &6&lKyusama&r&7 and the &e&lPokémon League Trophy&r&7 is yours. It is &anot consumed&7 here."
		""
		"&7With the three &d&lSpire Trophies&r&7 of the &e&lBadge&r&7 chapter, that is all four. &a&lYou finished PixelGO."
	]
	quest.6096808D07872933.quest_subtitle: "&7Taken from the Rival"
	quest.6096808D07872933.title: "&e&lPokémon League Trophy"
	quest.60A285A65AF57059.quest_subtitle: "&aUncommon"
	quest.60AF32A86B34C3D6.quest_subtitle: "&7Beat &f&l10&r&7 trainers"
	quest.60AF32A86B34C3D6.title: "&c&lRookie Trainer"
	quest.60F8A85A429237B6.quest_subtitle: "&7Beat &f&l50&r&7 trainers"
	quest.60F8A85A429237B6.title: "&9&lAce Trainer"
	quest.60FCC14DCBD24894.quest_desc: [
		"&7All &f&l8&r&7 challenges of the &9&lblue&r&7 row are behind you. The &9&lBlue Trophy&r&7 is yours to put on a shelf."
		""
		"&a&lThe &e&lyellow&a&l row is open."
	]
	quest.60FCC14DCBD24894.quest_subtitle: "&7Every blue challenge, done"
	quest.60FCC14DCBD24894.title: "&9&lBlue Trophy"
	quest.610BF9120D3304A6.quest_desc: [
		"&7&o\"You cleared every bracket, so there is nothing left to climb. Except me, with no limits left. This is Zenith Omega.\""
		""
		"&7Zenith Omega only fights trainers who cleared &f&lall ten&r&7 brackets. Call him with a &c&lRival Beacon&r&7: once the ten are done, the beacon calls him and nobody else."
		""
		"&e&lFIRST CLEAR"
		"&7The &5&lOmega Medal&r&7, &6&l30 000 PokéDollars&r&7, 32 Rare Candies, 6 Gold Bottle Caps, 6 PP Max, 2 Ability Patches and a &e&lShiny Charm&r&7."
		""
		"&7&o\"Perfect. There is nothing left of me to beat. The rivalry is yours now.\""
	]
	quest.610BF9120D3304A6.quest_subtitle: "&7The rival with no limits left"
	quest.610BF9120D3304A6.title: "&5&lZenith Omega"
	quest.610F55A825E6F0E3.quest_desc: [
		"&7Awarded by &f&lMinato Namikaze&r&7, &oThe Yellow Flash&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 7&r&7 of 7."
		""
		"&e&lTeam:&r &fCrobat&7, &fStaraptor&7, &fTalonflame&7, &fKilowattrel"
		"&7IVs of &f&l31&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l1150&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.610F55A825E6F0E3.quest_subtitle: "&6Solaris Spire &8- &7Floor 7"
	quest.613532DBB47FFC75.quest_desc: [
		"&7Thank you for playing &5&lPixelGO &r&7- &3&lTo the Sky&r 2&7."
		""
		"&e&lWHERE AM I?"
		"&7You start on a small island, and that island is &a&lin the Overworld&r&7. There is no Void dimension and no portal to craft: this &oIS&r&7 the Overworld, and it is empty in every direction."
		"&c&lThere is no terrain and no ore anywhere in the world. &7Everything you will ever own has to come out of your island, through the &6&lsieve&r&7 and the &6&lcrucible&r&7."
		""
		"&7The Nether and the End are empty too, with two exceptions: &c&lNether Fortresses&r&7 still generate, and the End keeps its main island - so blazes, wither skeletons and the &5&ldragon&r&7 are all still reachable."
		""
		"&e&lCOMMANDS"
		"&b/pixelsell &8- &7sells the item in your hand"
		"&b/pixelsell all &8- &7sells every sellable item you are carrying"
		"&b/pixelvalue &8- &7tells you what an item is worth before you sell it"
		""
		"&7There is also a &a&lSell&r&7 button on your inventory screen. Same thing, one click."
		""
		"&e&lTHE REST OF THIS PAGE"
		"&7Every other quest here is a short card about one part of the pack. They cost you nothing: read one, tick it, take the reward."
		""
		"&3Tick every checkmark in this chapter to read the whole guide."
	]
	quest.613532DBB47FFC75.quest_subtitle: "&2Basic information about the pack. &4Please read."
	quest.613532DBB47FFC75.title: "&4&lInfo"
	quest.6154BB10414AA1A1.quest_desc: [
		"&7The core of a &f1 024B&7 fluid disk: &f&l1 024 buckets&r&7."
		"&7Fluid disks hold &flava, water, essences...&7 and show them in the Grid, beside your items."
		"&7Built on the part of the tier below."
		""
		"&7Put it in a &fStorage Housing&7 for a disk."
	]
	quest.6154BB10414AA1A1.quest_subtitle: "&7A fluid disk of 1 024 buckets"
	quest.6154BB10414AA1A1.title: "&9&l1 024B Fluid Storage Part"
	quest.61A2E44786F71B33.quest_desc: ["{quest.minions.description.4}"]
	quest.61A2E44786F71B33.title: "{quest.minions.title.5}"
	quest.61C9BC202F4ABBA4.quest_desc: [
		"&7&lD&r&7 is where elite guards start appearing and the chests start paying."
		""
		"&e&lPOKEMON"
		"&7Level &f&l15 to 30&r&7. Base stat total capped at &f&l450&r&7. No Legendaries."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l8&r&7 Pokemon in total"
		"&7&l- &f&l2 to 3&r&7 combat rooms"
		"&7&l- &f&l1&r&7 elite guard"
		"&7&l- &7a &f&lrare&r&7 boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l2600&r&7 of &f&l10000&r&7 - &a&l26%&r&7 of all natural Gates."
		""
		"&e&lIN THE CHESTS"
		"&7Great, Ultra and Quick Balls. Super and hyper potions, revives. S and M candies, nuggets, heart scales, rare candies."
		"&a&lAnd the four basic evolution stones&r&7: fire, water, thunder and leaf."
	]
	quest.61C9BC202F4ABBA4.quest_subtitle: "&7Green. The first real fight."
	quest.61C9BC202F4ABBA4.title: "&7&lRank D"
	quest.61E6FBC17CE652B9.quest_desc: ["&7Catch rate &fx1&7, but the Pokémon is &afully healed&7 the moment it is caught — HP, PP and status."]
	quest.61E6FBC17CE652B9.quest_subtitle: "&7Caught and patched up"
	quest.61E6FBC17CE652B9.title: "&d&lHeal Ball"
	quest.623BC4E03797741F.quest_desc: ["{quest.kalos.description.7}"]
	quest.623BC4E03797741F.title: "{quest.kalos.title.2}"
	quest.625004EB4ECD5C83.quest_desc: [
		"&7&l- &fWild Encounter&7 - a wild Pokémon takes a liking to yours and joins your team. Higher difficulties find rarer ones. 1h to 4h"
		"&7&l- &fHatchling Search&7 - finds a newborn Pokémon, Great and Ultra Ball, 1h to 2h"
		""
		"&7Rarity follows the catch rate of the species: the harder a Pokémon is to catch, the rarer it comes back."
		"&c&lMake room first: &7the newcomer goes to your party or PC, and a full PC blocks the claim."
		""
		"&7&oThis card is a guide: tick it once read. Exact rewards are in JEI, under Expeditions."
	]
	quest.625004EB4ECD5C83.quest_subtitle: "&7Someone comes back with a friend"
	quest.625004EB4ECD5C83.title: "&d&lNew Pokémon"
	quest.62512F78983F1636.quest_desc: [
		"&7One per network. Everything connected to it shares the same storage."
		""
		"&c&lIt needs power. &7Feed it FE from any generator. The more blocks on the network, the more it draws."
		"&7A Controller that still holds energy keeps it when broken."
	]
	quest.62512F78983F1636.quest_subtitle: "&7The heart of the network"
	quest.62512F78983F1636.title: "&b&lController"
	quest.62604960C94936F9.quest_desc: [
		"&7The empty shell almost every Refined Storage block is built around."
		""
		"&7Recipe in &6JEI&7."
	]
	quest.62604960C94936F9.quest_subtitle: "&7The frame of every machine"
	quest.62604960C94936F9.title: "&f&lMachine Casing"
	quest.62683632D69222D1.quest_desc: [
		"&7Soularium ingot and nuggets plus &fQuartz Dust&7 give &a2 chains&7 per craft."
		""
		"&7Four of them build the &5&lEnsouled Chassis&r&7."
	]
	quest.62683632D69222D1.quest_subtitle: "&7Soularium held together by quartz"
	quest.62683632D69222D1.title: "&5&lSoul Chain"
	quest.628AD12BCDE55F0C.quest_desc: ["{quest.johto.description.6}"]
	quest.628AD12BCDE55F0C.title: "{quest.johto.title.2}"
	quest.6295A213F651A6C2.quest_desc: [
		"&e&lCHECK FIRST"
		"&b/pixelvalue &8- &7what is the stack in my hand worth? Free, and it tells you &obefore&r&7 you commit."
		""
		"&e&lTHEN SELL"
		"&b/pixelsell &8- &7sells the stack in your hand"
		"&b/pixelsell all &8- &7sells every sellable item you are carrying"
		""
		"&7The &a&lSell&r&7 button on your inventory screen does the same as &b/pixelsell all&7, and asks you to confirm first."
		""
		"&c&lWhat has no price cannot be sold. &7If the game tells you an item has no listed price, then no shop in the pack buys it - there is no second place to try."
		""
		"&7&oPrices come from the shops themselves. If a shop sells it, that shop buys it back, for less."
	]
	quest.6295A213F651A6C2.quest_subtitle: "&7Three ways, one price list"
