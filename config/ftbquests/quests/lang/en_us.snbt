	]
	quest.0040F3DFEB349523.quest_desc: [
		"&7The core of a &f262 144B&7 fluid disk: &f&l262 144 buckets&r&7."
		"&7Fluid disks hold &flava, water, essences...&7 and show them in the Grid, beside your items."
		"&7Built on the part of the tier below."
		""
		"&7Put it in a &fStorage Housing&7 for a disk."
	]
	quest.0040F3DFEB349523.quest_subtitle: "&7A fluid disk of 262 144 buckets"
	quest.0040F3DFEB349523.title: "&3&l262 144B Fluid Storage Part"
