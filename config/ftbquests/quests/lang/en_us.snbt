	quest.74BCE9E73DCDF3E0.title: "{quest.mekanism.title.4}"
	quest.74EB0BD57D853B93.quest_desc: [
		"&7Put an item in the target slot and feed the condenser anything else: it burns what you give it into EMC and builds copies of the target. The MK2 keeps input and output apart, so hoppers or pipes can fill one side and empty the other."
		"&c&lNo free EMC: &r&7with collectors and relays gone, a condenser only spends the value of the items you give it - it never creates any."
		""
		"&7Unlocks the &f&lWhite Ticket&r&7 and the &fWhite Egg [MK 14]&7 - see &6JEI&7."
	]
	quest.74EB0BD57D853B93.quest_subtitle: "&7Tier 14 &8- &fWhite Ticket"
	quest.74EB0BD57D853B93.title: "&d&lEnergy Condenser MK2"
	quest.753155DEE6C4A6F4.quest_desc: ["&7Every Ender IO machine has a &6capacitor slot&7. A better capacitor means &amore speed&7 and &amore energy buffer&7."]
