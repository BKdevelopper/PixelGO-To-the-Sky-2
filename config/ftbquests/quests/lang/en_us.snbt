		""
		"&6&lThe chain&r"
		"&f Cobblestone &8→ &fGravel &8→ &fSand &8→ &f&lDust"
		"&7One blow at a time — and &nevery&r&7 step goes back into the sieve."
		""
		"&e&lTip:&r &7Hammers take &aUnbreaking&7 and &aEfficiency&7. A cheap hammer with two enchantments beats a bare expensive one."
	]
	quest.543BD026DEA382F4.quest_subtitle: "&8Cobble to gravel to sand to dust"
	quest.543BD026DEA382F4.title: "&b&lStone Hammer"
	quest.5511DA2DB4440828.quest_desc: ["{quest.alola.description.11}"]
	quest.5511DA2DB4440828.title: "{quest.alola.title.2}"
