	quest.3D9FFDC8AECA5C38.title: "&a&lAdd IV SPD"
	quest.3DA28FA71D456870.quest_desc: ["{quest.fossils.description.5}"]
	quest.3DA9CB6024DF0C9D.quest_desc: [
		"&7The same &a&lCobblestone Minion&r&7, one tier up."
		""
		"&e&lUPGRADING"
		"&7Right click the placed minion and press &aUpgrade&7. The cost of every tier is in JEI."
		"&7To hand it in, press &aPickup&7: the minion comes back as an item &f&lat its tier&r&7."
	]
