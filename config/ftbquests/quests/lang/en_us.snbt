	quest.571BE253F719E97F.quest_subtitle: "&6Solaris Spire &8- &7Floor 5"
	quest.57317DF18B3EE451.quest_desc: [
		"&7The hammer you will actually keep. Speed and durability in one tool."
		""
		"&e&lTip:&r &7Diamonds come out of the &egravel&7 sieve — you do not need a mine, just patience."
	]
	quest.57317DF18B3EE451.quest_subtitle: "&7The workhorse"
	quest.57317DF18B3EE451.title: "&b&lDiamond Hammer"
	quest.575A4C5A802E6062.quest_desc: [
		"&7Awarded by &f&lKirito&r&7, &oTower Sovereign&r&7."
		"&7Found in the &b&lTidal Spire&r&7, on &f&lfloor 7&r&7 of 7."
		""
		"&e&lTeam:&r &fAlakazam&7, &fMetagross&7, &fGallade&7, &fCeruledge"
		"&7IVs of &f&l31&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l1250&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
