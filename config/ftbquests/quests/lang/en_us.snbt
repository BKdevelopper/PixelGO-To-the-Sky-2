	quest.5535AEE797301233.quest_subtitle: "&aUncommon"
	quest.5542F8CDEF75286B.quest_desc: [""]
	quest.5573A6C63F542C9E.quest_desc: [
		"&7&oNine threads between you and starvation.&r"
		""
		"&6&lWhat it gives&r"
		"&8· &fDirt &8→ &awheat&7, &amelon&7, &apumpkin &7and &abeetroot &7seeds, &6carrots&7, &6potatoes&7, &asugar cane&7, &abamboo"
		"&8· &fGravel &7and &fsand &8→ &7flint and stone pebbles"
		"&8· &fDust &8→ &fbone meal"
		""
		"&c&lNo metal at this tier.&r"
		"&7Ore starts at the &eIron Mesh&7, and that one sits behind the &d&lHarvest Certificate&r&7."
	]
	quest.5573A6C63F542C9E.quest_subtitle: "&8Tier 1 — the sieve does nothing without it"
	quest.5573A6C63F542C9E.title: "&e&lString Mesh"
	quest.558BF0466035CD5A.quest_desc: ["&7Evolves at level &f&l40&r&7"]
	quest.55C2DFC0477B0B59.quest_desc: ["{quest.minions.description.18}"]
	quest.55C2DFC0477B0B59.title: "{quest.minions.title.19}"
	quest.55C486FE0A3CBF97.quest_desc: [
		"&7&oA bucket of rot is worth more than a diamond up here.&r"
		""
		"&6&lCompost&r"
		"&7Throw in &aleaves&7, &asaplings&7, &aseeds&7 or &fsilkworms&7 until it fills: it becomes &f&lDirt&r&7. This is how your field grows."
		""
		"&b&lMix&r"
		"&8· &bWater &7+ &fDust &8→ &fClay"
		"&8· &bWater &7+ &fSand &8→ &fSoul Sand"
		"&8· &bWater &7+ &cLava &8→ &5Obsidian"
		""
		"&e&lTip:&r &7Left under the open sky, a barrel fills with rain on its own."
	]
	quest.55C486FE0A3CBF97.quest_subtitle: "&8Compost in, dirt out"
	quest.55C486FE0A3CBF97.title: "&6&lThe Barrel"
	quest.55D12C2C483BB698.quest_desc: [
		"&7Whatever you catch arrives with a &nmaxed&r&7 Sp. Attack EV spread: &f252&7 points, the per-stat cap."
		""
		"&e&lTip:&r &7EVs are capped at &f510 total&7. Two maxed stats is the whole budget — pick the two that matter and do not waste a third ball."
	]
	quest.55D12C2C483BB698.quest_subtitle: "&7252 EVs, the instant it is caught"
	quest.55D12C2C483BB698.title: "&d&lEV Sp. Attack Ball"
	quest.55F6E8D31C5C40A1.quest_desc: ["{quest.fossils.description.9}"]
	quest.55FD97852DFF8A03.quest_desc: [
		"&7One of the four pieces of the &a&lOrange Hair&r&7 outfit. Purely for looks."
		""
		"&7Crafted at the workbench - &bJEI&7 has the recipe."
		"&7The whole outfit is also the reward of the &9&lCascade Badge&r&7, in the Badge chapter."
	]
	quest.55FD97852DFF8A03.quest_subtitle: "&7Part of the Orange Hair outfit"
	quest.55FD97852DFF8A03.title: "&a&lOrange Hair Cap"
	quest.560C102A06B24D04.quest_desc: [
		"&7&lRight click&r &7any living mob with an empty vial to capture it, right click a block to release it."
		""
		"&e&lTip:&r &7A filled vial is the fuel of the &5&lSoul Binder&r&7: it is how you bind a mob soul into a crystal or a machine."
	]
	quest.560C102A06B24D04.quest_subtitle: "&7Catch a mob, carry it home"
	quest.560C102A06B24D04.title: "&5&lSoul Vial"
	quest.56298C5E85C44E09.quest_desc: [
		"&7Awarded by &f&lSentinel Topaz&r&7, &oTower Warden&r&7."
		"&7Found in the &5&lUmbral Spire&r&7, on &f&lfloor 3&r&7 of 7."
		""
		"&e&lTeam:&r &fClodsire&7, &fRhyperior&7, &fGolurk&7, &fHippowdon"
		"&7IVs of &f&l16&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l750&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.56298C5E85C44E09.quest_subtitle: "&5Umbral Spire &8- &7Floor 3"
	quest.5656F804A1E924B4.quest_desc: [
		"&7Walk into a &5&lRank A&r&7 Gate, fight your way to the boss room and &abeat the boss&7."
		""
		"&e&lWHEN IT COUNTS"
		"&7The quest is done the moment the &a&lexit Gate&r&7 opens in the boss room. Stay inside until then: being thrown out by a lost battle does not count."
		"&7Every player near the boss room when it opens gets it, so a team clears it together."
		""
		"&e&lWHERE TO FIND ONE"
		"&7&l- &7A natural Gate opening near your island, or"
		"&7&l- &7a &b&lA-Rank Gate Beacon&r&7, which opens one on the spot"
	]
	quest.5656F804A1E924B4.quest_subtitle: "&7Beat the boss of a Rank A Gate"
	quest.5656F804A1E924B4.title: "&c&lClear a Rank A Gate"
	quest.56A0FC0873E168F8.quest_desc: ["{quest.fossils.description.11}"]
	quest.56ED2AED915C41D1.quest_desc: [
		"&7The lid is made from &ccooked apricorns&7 on a plain &fcrafting table&7 — Pixelmon's own recipe, untouched."
		""
		"&7Each ball has its own lid, and its own mix of colours: look the one you want up in &6JEI&7."
	]
	quest.56ED2AED915C41D1.quest_subtitle: "&7The top half of the ball"
	quest.56ED2AED915C41D1.title: "&e&lThe Lid"
	quest.571BE253F719E97F.quest_desc: [
		"&7Awarded by &f&lAnya Forger&r&7, &oMind Reader&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 5&r&7 of 7."
		""
		"&e&lTeam:&r &fEspeon&7, &fGardevoir&7, &fMusharna&7, &fIndeedee"
		"&7IVs of &f&l24&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l850&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
