	quest.360D5DE82359532A.quest_subtitle: "&7Tier 6 &8- &9Blue Ticket"
	quest.360D5DE82359532A.title: "&6&lAeternalis Fuel Block"
	quest.361F2484977B7C2F.quest_desc: ["&7&a&lPixelGO Items&r&7 raise a single IV by one point, up to &f&l31&r&7. They come out of the &a&lMetallurgic Infuser&r&7 (Mekanism) and from the &e&lbadges&r&7 of the Battle Towers - see the &6&lPixelGO Items&r&7 chapter."]
	quest.361F2484977B7C2F.title: "{quest.minions.title.24}"
	quest.36A44692E315D8A4.quest_desc: ["&e&lTip:&r &7Cobblestone is the entry point of the whole hammer chain: &fcobble&7 → &fgravel&7 → &fsand&7 → &f&lDust&r&7, and every one of those goes back into the sieve."]
