	]
	quest.39360AD91700CD97.quest_subtitle: "&7Red Matter Gem Armor"
	quest.39360AD91700CD97.title: "&c&lGem Chestplate"
	quest.3941792F5C282C99.quest_desc: [
		"&7A harvesting tool made for &fcocoa beans&7 and nothing else."
		""
		"&e&lWHY BOTHER"
		"&7&l- &7It adds &a&lFarming Fortune&r&7 on cocoa beans: every &f&l100&r&7 fortune is one more drop per harvest"
		"&7&l- &7Only a &aspecialised tool&7 can roll the rare crop drops"
		"&7&l- &7It levels up as you use it"
		""
		"&7The recipe is in JEI."
	]
	quest.3941792F5C282C99.quest_subtitle: "&7The specialised tool for cocoa beans"
	quest.3941792F5C282C99.title: "&a&lCocoa Chopper"
	quest.39962F9692B0C0C7.quest_desc: [
		"&7The base is the bottom half of the ball."
		""
		"&7Every ball takes a base, and any base fits: &fIron&7, &7Silver&7, &bPlatinum&7, &fAluminium&7 or &6Wooden&7. Use whichever metal you have the most of."
		""
		"&c&lThe old description here mentioned an anvil mini-game.&r &7That was the 1.16.5 flow. There is no anvil step in this pack — lid, button and base go straight on a crafting table."
	]
	quest.39962F9692B0C0C7.quest_subtitle: "&7Half a ball, waiting for a lid"
