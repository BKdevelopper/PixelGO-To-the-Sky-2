	quest.3DA9CB6024DF0C9D.title: "&7&lCobblestone Minion III"
	quest.3DC42BB024A1F00C.quest_desc: [
		"&9&lRedstone Conduits&r &7carry up to &a16 coloured channels&7 in a single line."
		""
		"&7The &e&lConduit Probe&r &7copies the whole configuration of a conduit and pastes it onto another one."
	]
	quest.3DC42BB024A1F00C.quest_subtitle: "&7Signals and logic in one block"
	quest.3DC42BB024A1F00C.title: "&9&lRedstone Conduits"
	quest.3DC668CBC53DA73C.quest_desc: [
		"{quest.unconventional_evolution.description.19}"
		"{quest.unconventional_evolution.description.20}"
	]
	quest.3DCC93742DAB1733.quest_desc: [
		"&7&lThere is only one balance.&r&7 What you win in a Pixelmon battle and what you make from selling items all go to the same place."
		""
		"&e&lHOW TO EARN"
		"&7&l- &7Beat wild Pokemon and trainers"
		"&7&l- &7Sell items, with &b/pixelsell&7 or the &a&lSell&r&7 button"
		"&7&l- &7Quest rewards, right through this book: they pay in &6&lNickels&r&7, &6&lDimes&r&7 and &6&lPoke Coins&r&7 - sell them"
		"&7&l- &7Clear &d&lGates&r&7 and sell what the chests give you"
		""
		"&e&lHOW TO SPEND"
		"&7The &6&lShop&r&7 chapter and the &b&lPortable Shop&r&7 both draw on that balance."
		""
		"&c&lSome things are only ever sold, never crafted. &7Minion tools and the PixelGO Poke Balls have no recipe at all. Money is the only way in."
	]
	quest.3DCC93742DAB1733.quest_subtitle: "&7One wallet for the whole pack"
	quest.3DCC93742DAB1733.title: "&6&lPokeDollars"
	quest.3DD05F31CD9769EF.quest_desc: [
		"&b/pixelgate &7is the administrative side of the system. &c&lThe whole command requires permission level 2&r&7, so an ordinary player cannot run any part of it - not even leave."
		""
		"&b/pixelgate open &8<rank> &8- &7force a Gate open where you stand"
		"&b/pixelgate list &8- &7every dungeon currently running: rank, players, Pokemon left, and which boss"
		"&b/pixelgate leave &8- &7pull yourself out of the dungeon you are in"
		"&b/pixelgate verify &8- &7build one dungeon of every rank and report the numbers"
		""
		"&7&overify is the one to run after changing the config. It tells you, per rank, how many rooms and Pokemon actually got built and how long it took."
	]
	quest.3DD05F31CD9769EF.quest_subtitle: "&8Operators only"
	quest.3DD05F31CD9769EF.title: "&8&lThe Command"
	quest.3DFCB9B21A2ADDB4.quest_subtitle: "&9Rare"
	quest.3E20E71D88593E9C.quest_desc: [
