	quest.7B503E46FD555C5B.quest_desc: [
		"&7A &a&lHopper Botany Pot&r&7 that runs on power: whatever grows in it grows faster, and gives more."
		""
		"&e&lWHAT IT GIVES"
		"&7&l- &7Growth speed &8- &a&lx2"
		"&7&l- &7Yield &8- &a&lx1"
		""
		"&e&lWHAT IT NEEDS"
