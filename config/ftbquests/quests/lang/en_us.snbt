	quest.3D87667121F06219.quest_subtitle: "&8Water in a barrel, then lava"
	quest.3D87667121F06219.title: "&5&lObsidian"
	quest.3D9FFDC8AECA5C38.quest_desc: [
		"&7Right-click one of your Pokémon to raise its Speed IV by &f&l1&r&7, up to &f&l31&r&7."
		""
		"&7Made in the &a&lMetallurgic Infuser&r&7 (Mekanism) - &bJEI&7 has the recipe."
