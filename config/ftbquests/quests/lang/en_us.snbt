	quest.5C965464AA01EDC2.quest_desc: [
		"{quest.extended_crafting.description.2}"
		"{quest.extended_crafting.description.3}"
	]
	quest.5CB0CDB213C1ED2A.quest_desc: ["{quest.kanto.description.14}"]
	quest.5CB0CDB213C1ED2A.quest_subtitle: "{quest.kanto.subtitle.5}"
	quest.5CB0CDB213C1ED2A.title: "{quest.kanto.title.18}"
	quest.5CBE28FF80139FB3.quest_desc: ["{quest.unova.description.1}"]
	quest.5CBE28FF80139FB3.title: "{quest.unova.title.3}"
	quest.5CDA230F48BE16FC.quest_desc: [
		"&7The tier after the &a&lGold Cobblestone Generator&r&7: faster, and it holds more."
		""
		"&e&lWHAT IT GIVES"
		"&7&l- &7Speed &8- &f&l1&r&7 every &f&l1&r&7 s"
		"&7&l- &7Storage &8- &f&l64&r&7 cobblestone before it stops"
		""
		"&e&lUPGRADING IN PLACE"
		"&7No need to break the old one: the matching &a&lGenerator Upgrade&r&7, used with &bCrouch + Right Click&7 on the gold generator, turns it into this one."
		"&7Already upgraded it in the world? &aBreak it&7: a generator always drops itself, tier included, so you can hand it in."
	]
	quest.5CDA230F48BE16FC.quest_subtitle: "&7A cobblestone every 1 s"
	quest.5CDA230F48BE16FC.title: "&b&lDiamond Cobblestone Generator"
	quest.5CE3ACAFBE790C28.quest_desc: ["{quest.extended_crafting.description.15}"]
	quest.5D3A7EC8C92AF9BB.quest_desc: [
		"&7Your first source of energy. It burns any furnace fuel and pushes power directly into adjacent machines."
		""
		"&e&lTip:&r &7A capacitor inside makes it burn &afaster&7, not longer. Feed it with a &fFarming Station&7 or a wood farm later on."
	]
	quest.5D3A7EC8C92AF9BB.quest_subtitle: "&7Burn solid fuel, get power"
	quest.5D3A7EC8C92AF9BB.title: "&b&lStirling Generator"
	quest.5D603B8F873ED9AC.quest_desc: [""]
	quest.5D67F40D6B8E19A5.quest_desc: [
		"&7One room holds the boss. Chat announces it, and the Pokemon that rises is scaled up - larger than anything else in the dungeon."
		""
		"&e&lBOSS QUALITY BY RANK"
		"&8&lE &8- &7common"
		"&7&lD &7and &e&lC &8- &7rare"
		"&6&lB &8- &7epic"
		"&c&lA &8- &7legendary"
		"&d&lS&r&7, &c&lSS&r&7, &6&lSSS&r&7 and &4&lDEMON &8- &7ultimate"
		""
		"&c&lFrom rank A upward the boss can be an actual Legendary Pokemon. &7That is the fastest legendary encounter in the pack, and the hardest fight in it."
		""
		"&7In a &4&lDEMON&r&7 Gate there is no \"can be\" about it - the whole dungeon is drawn from a list of Legendaries, so the boss is one by definition."
		""
		"&a&lBeat it and the screen reads Dungeon Cleared. &7An &a&lexit Gate&r&7 opens in the boss room. Right click it and you go home with everything you picked up."
	]
	quest.5D67F40D6B8E19A5.quest_subtitle: "&7And the only door home"
	quest.5D67F40D6B8E19A5.title: "&5&lThe Boss"
	quest.5D8C7B290B6C6DE3.quest_desc: ["&7An empty pattern. Encode a recipe on it in a &fPattern Grid&7, put it in an &fAutocrafter&7, and the network knows how to make that item."]
	quest.5D8C7B290B6C6DE3.quest_subtitle: "&7A recipe the network remembers"
	quest.5D8C7B290B6C6DE3.title: "&e&lPattern"
	quest.5DBDF933C9610A23.quest_subtitle: "&aUncommon"
	quest.5DC3CBEE0A994222.quest_desc: ["&7Catch rate &bx3.5&7 against &9Water&7 and &aBug&7 types, &fx1&7 on anything else."]
	quest.5DC3CBEE0A994222.quest_subtitle: "&7For Water and Bug types"
	quest.5DC3CBEE0A994222.title: "&b&lNet Ball"
	quest.5DDF0B4962504872.quest_desc: [
		"&7Drop an item into the table to &fburn&7 it: it turns into &d&lEMC&r&7 and the table &flearns&7 it. From then on you can create that item for its EMC value, as often as your EMC allows."
		"&7Your EMC and what you have learned belong to &fyou&7, not to the table: every table shows the same thing."
		"&7A &b&lKlein Star&r&7 put in the table is filled from your EMC, so you can carry it around."
		""
		"&c&lNO FREE EMC"
		"&7EMC generation is disabled: collectors and relays have been removed. The table only moves value around - you have to burn items to make others."
		"&7Items the shops buy are worth &f0 EMC&7."
	]
	quest.5DDF0B4962504872.quest_subtitle: "&7Burn an item, learn it, make it again"
	quest.5DDF0B4962504872.title: "&d&lTransmutation Table"
	quest.5DF252D342748189.quest_desc: [
		"&7Hit &fleaves&7 with the &eCrook&7 until a &f&lSilkworm&r &7drops."
		""
		"&6&lTurning them into string&r"
		"&7- Put the silkworms in a &fBarrel&7 to compost them into &fString&7."
		"&7- Or cook them: a &fCooked Silkworm&7 is edible in a pinch."
		""
		"&e&lTip:&r &7Four strings make the &eString Mesh&7 — the whole sieve chain starts here."
	]
	quest.5DF252D342748189.quest_subtitle: "&7No string without them"
	quest.5DF252D342748189.title: "&e&lSilkworms"
	quest.5E1ECF869F05BBEC.quest_desc: [
		"&7Right-click one of your Pokémon to set it to a random level between &f&l1&r&7 and &f&l100&r&7."
		""
		"&7Made at the &fUltimate Crafting Table&7 (9x9) from one of &aevery berry&7."
