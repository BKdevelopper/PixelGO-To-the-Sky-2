	quest.39F847FDA152635C.title: "{quest.alola.title.2}"
	quest.3A096578AAB672EA.quest_subtitle: "&7Common"
	quest.3A3A6DFA24D77E09.quest_desc: [
		"&5Level V&7 is the cap declared by the mod. There is nothing above it."
		""
		"&7Eight enchanted diamonds and four enchanted mithril is &f1 280&7 diamonds and &f640&7 mithril. But the &5&lUltimate Control Circuits&r&7 are the real lock: each one is an atomic alloy on an elite circuit, and atomic alloy wants &5Refined Obsidian&7 and &5Polonium&7-grade patience."
		""
		"&c&lThis book is a project, not a craft.&r"
		""
		"&e&lTip:&r &7The enchantment sits on the &nball&r&7, and the ball is consumed on the throw. Enchant a stack you keep for legendaries."
	]
	quest.3A3A6DFA24D77E09.quest_subtitle: "&7The maximum the enchantment allows"
	quest.3A3A6DFA24D77E09.title: "&5&lCatch Rate V"
	quest.3A481C17C7F6FE9E.quest_desc: [
		"&d&lCatch Rate&r&7 is an enchantment from the &6PixelGO&7 mod. It goes on &nnothing but a Poké Ball&r&7, and adds a flat capture bonus to every throw."
		""
		"&e&lWhy a table and not a machine?&r"
		"&7Because a machine &ncannot send an enchanted book to the client&r&7 unless its recipe serialiser has registry access — and since 1.21 enchantments live in a datapack registry. Get that wrong and the recipe packet fails and every player is kicked on join. It happened once already in this pack."
		"&7The table is only the bench: &nthe ingredients are all Mekanism&r&7."
		""
		"&e&lTip:&r &7Levels &fII&7 and &fIV&7 are not crafted. Put two books of the level below on an &7&lanvil&r&7, exactly like any vanilla enchantment."
		""
		"&c&lNever put this book in a shop&r&7 — for exactly the same reason it cannot come out of a machine."
	]
	quest.3A481C17C7F6FE9E.quest_subtitle: "&7An enchantment that only fits a Poké Ball"
	quest.3A481C17C7F6FE9E.title: "&d&lCatch Rate I"
	quest.3A546DDCCE4B3461.quest_desc: ["&7&d&lSquirtle&r&7 evolves at level &f&l16&r&7"]
	quest.3A546DDCCE4B3461.quest_subtitle: "{quest.kanto.subtitle.5}"
	quest.3A546DDCCE4B3461.title: "{quest.kanto.title.16}"
	quest.3A6B2F5F32758063.quest_desc: [
		"&7Awarded by &f&lSentinel Vesper&r&7, &oTower Sentinel&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 1&r&7 of 7."
		""
		"&e&lTeam:&r &fWeezing&7, &fMuk&7, &fToxtricity&7, &fNidoking"
		"&7IVs of &f&l8&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l250&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.3A6B2F5F32758063.quest_subtitle: "&6Solaris Spire &8- &7Floor 1"
	quest.3A82D518FDBD0097.quest_subtitle: "&7Catch &f&l50&r&7 Steel-type Pokémon"
	quest.3A82D518FDBD0097.title: "&5&lSteel Collector"
	quest.3AC1D6224F363C59.title: "{quest.unconventional_evolution.title.22}"
	quest.3AD1713C5EFB9564.quest_desc: [
		"&7The caught Pokémon has &f31 Sp. Attack IV&7 — the maximum. IVs cannot be trained away or improved without Hyper Training, so this is permanent perfection on one stat."
		""
		"&e&lTip:&r &7Catch the same species repeatedly with different IV balls and breed the results — the &fDestiny Knot&7 passes five IVs down."
	]
	quest.3AD1713C5EFB9564.quest_subtitle: "&7A perfect 31, guaranteed"
	quest.3AD1713C5EFB9564.title: "&d&lIV Sp. Attack Ball"
	quest.3B02FBE7DF7D72FC.quest_desc: ["{quest.johto.description.7}"]
	quest.3B02FBE7DF7D72FC.title: "{quest.johto.title.2}"
	quest.3B427C891134E9E2.quest_desc: [
		"&7&oA curved claw, sharp enough to raise critical hits.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		""
		"&e&lEvolutions&r"
		"&f- Sneasel &7→ &aWeavile"
		"&f- Sneasel &7→ &aSneasler"
	]
	quest.3B427C891134E9E2.title: "{quest.unconventional_evolution.title.39}"
	quest.3B4CFACEBCF0D146.quest_desc: [
		"&7&fRight-click&7 to pick a structure - dungeons, villages, Pixelmon structures... - and the compass points to the closest one."
		""
		"&7Made on the Mystical Agriculture &fInfusion Altar&7, from Nature's Compasses and Berry Singularities."
		"&7Recipe in &6JEI&7."
	]
	quest.3B4CFACEBCF0D146.quest_subtitle: "&7Points to any structure"
	quest.3B4CFACEBCF0D146.title: "&6&lExplorer's Compass"
	quest.3B5016BDED57B783.quest_desc: ["{quest.hoenn.description.4}"]
	quest.3B5016BDED57B783.title: "{quest.hoenn.title.3}"
	quest.3B88EA5D95250631.quest_desc: [
		"&7Right-click to summon a random &fnon-legendary&7 Pokémon next to you. The ticket is used up, and you can use one every &f60 s&7."
		"&7MK 0 adds no bonus: any IVs, normal shiny odds."
		""
		"&e&lWHERE IT COMES FROM"
		"&7- one every &fhour of play&7, on its own"
		"&7- Poké Chests"
		"&7- the crafting table - see &6JEI&7"
		""
		"&e&lTHE TIERS"
		"&7Each coloured ticket on this row is one tier up, &fMK 1&7 to &fMK 16&7: a higher minimum IV and a better shiny chance. The ProjectE item under each ticket is what unlocks its tier."
		"&7The reward eggs follow the same tiers. A PixelmonGo egg hatches in an &fEgg Incubator&7 after &f5 000&7 blocks of walking."
	]
	quest.3B88EA5D95250631.quest_subtitle: "&7The base ticket &8- &7MK 0"
	quest.3B88EA5D95250631.title: "&7&lLight Gray Ticket"
	quest.3B89B5410E999E6D.quest_desc: [
		"&c&lThe Gate you walked through stays outside. &7There is no copy of it inside the dungeon. Until the boss is dead there is no exit at all."
		""
		"&e&lTHE THREE WAYS OUT"
		"&a&l1. &7&lBeat the boss.&r&7 The exit Gate opens in the boss room. You leave with everything."
		"&c&l2. &7&lLose a battle.&r&7 The dungeon ejects you on the spot. You keep what you already picked up and lose the rest - and that dungeon is gone for good."
		"&8&l3. &7An operator runs &b/pixelgate leave&r&7. That command needs permission level 2, so it is not something you can do for yourself."
		""
		"&c&lDo not enter a Gate you are not prepared to finish. &7Walking in underlevelled does not cost you time. It costs you the run."
		""
		"&7&oIf a dungeon is taken down while you are offline inside it, the game puts you back at spawn and says so in chat."
	]
	quest.3B89B5410E999E6D.quest_subtitle: "&4Read this one twice"
	quest.3B89B5410E999E6D.title: "&4&lThere Is No Back Door"
	quest.3B9B5E1DB7B9E151.quest_desc: [
		"&7Compacts the drops into blocks as they enter your inventory."
		""
		"&e&lTip:&r &7The book comes out at &fCompact X&7 — the maximum level — straight from the table. Cheaper copies also drop from &6Mystery Bags&7."
	]
	quest.3B9B5E1DB7B9E151.quest_subtitle: "&7Nine become one, automatically"
	quest.3B9B5E1DB7B9E151.title: "&d&lCompact X"
