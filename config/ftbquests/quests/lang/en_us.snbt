	quest.3D7DE4856E397629.title: "&a&lHarvesting VI"
	quest.3D87667121F06219.quest_desc: [
		"&7&oCooled in a wooden tub, which should not work, and does.&r"
		""
		"&6&lHow&r"
		"&7A &6Barrel&7 of &bwater&7, then a bucket of &clava&7 poured in."
		""
		"&6&lWhere it goes&r"
