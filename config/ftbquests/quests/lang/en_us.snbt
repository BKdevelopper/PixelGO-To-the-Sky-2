	quest.4B76E98F7B362BF5.quest_desc: [
		"&7Open to every Pokémon. Short runs, the island basics:"
		"&7&l- &fForest Forage&7 - food and wood"
		"&7&l- &fBerry Picking&7 and &fApricorn Harvest&7"
		"&7&l- &fLumber Camp&7 - every kind of log"
		"&7&l- &fQuarry Run&7 - stone, earth and gravel"
		"&7&l- &fFarm Harvest&7 - crops, seeds and bread"
		"&7&l- &fRanch Hand&7 - wool, leather, eggs and meat"
		"&7&l- &fFishing Trip&7"
		"&7&l- &fJungle Trek&7 - bamboo, cocoa and melons"
		"&7&l- &fDesert Trek&7 - sand, cactus and the odd relic"
		"&7&l- &fMeadow Stroll&7 - flowers and beehives, every dye"
		"&7&l- &fMonster Patrol&7 - the drops of the night's monsters"
		""
		"&7&oThis card is a guide: tick it once read. Exact rewards are in JEI, under Expeditions."
	]
	quest.4B76E98F7B362BF5.quest_subtitle: "&7Any Pokémon, 10 min to 1h20"
	quest.4B76E98F7B362BF5.title: "&a&lGathering"
	quest.4B886217219948D1.quest_desc: [
		"&7Every dungeon hides &f&l1&r&7 or &f&l2&r&7 loot chests. They are the reason you came."
		""
		"&e&lWHAT CLIMBS WITH THE RANK"
		"&7&l- &7&lBalls&r&7: Poke &8> &7Great &8> &7Ultra &8> &7Beast &8> &d&lMaster"
		"&7&l- &7&lHealing&r&7: potions &8> &7max potions &8> &7full restores"
		"&7&l- &7&lCandies&r&7: XS &8> &7S &8> &7M &8> &7L &8> &7XL, then &d&lRare Candy&r&7 by the stack"
		"&7&l- &7&lExtras&r&7: nuggets &8> &7evolution stones &8> &7bottle caps &8> &7ability patches"
		""
		"&c&lSearch every room before you fight the boss. &7Beating the boss opens the exit, and it is very easy to walk out of reflex with a chest still unopened behind you."
	]
	quest.4B886217219948D1.quest_subtitle: "&7One or two per dungeon"
	quest.4B886217219948D1.title: "&6&lThe Chests"
