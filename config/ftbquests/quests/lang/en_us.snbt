	quest.25615836ED4700A3.quest_subtitle: "&7A Tera Raid den, here and now"
	quest.25615836ED4700A3.title: "&a&lTera Raid Summoner"
	quest.25934671122EE560.quest_desc: [
		"&7Nine Dark Matter in one block. It builds the Dark Matter Furnace, the Pedestal and the Energy Condenser MK2 - and, in this pack, the &fWaystone&7."
		""
		"&7Unlocks the &2&lGreen Ticket&r&7 and the &fGreen Egg [MK 9]&7 - see &6JEI&7."
