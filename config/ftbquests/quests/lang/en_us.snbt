	quest.5799199EF482045B.quest_desc: ["{quest.minions.description.9}"]
	quest.5799199EF482045B.title: "{quest.minions.title.10}"
	quest.57C0F3B1BB5F44EB.quest_desc: [
		"&7Catch rate &bx4&7 on a &fsleeping&7 Pokémon."
		""
		"&e&lTip:&r &7Pair it with a move like Hypnosis or Spore."
	]
	quest.57C0F3B1BB5F44EB.quest_subtitle: "&7Only on sleeping targets"
	quest.57C0F3B1BB5F44EB.title: "&d&lDream Ball"
	quest.57C36737C12DDFF7.quest_subtitle: "&7Beat &f&l150&r&7 trainers"
	quest.57C36737C12DDFF7.title: "&e&lVeteran Trainer"
	quest.57F3367A8CFAF22A.quest_desc: ["{quest.extended_crafting.description.6}"]
	quest.583163C904E6A06F.quest_desc: ["&7&d&lServine&r&7 evolves at level &f&l36&r&7"]
	quest.583163C904E6A06F.title: "Evolve or Catch"
	quest.584862F348D76528.quest_desc: [
		"&7&o\"So you're the one everyone keeps talking about. Six Pokémon, no excuses. Show me.\""
		""
		"&6&lKyusama&r&7, the author of PixelGO, is hunting you. He comes back again and again, a little stronger each time: &f&lten brackets&r&7, from &fLv. 10&7 to &fLv. 100&7, and one more after that."
		""
		"&e&lFINDING HIM"
		"&7&l- &7He waits in &fvillages&7, one rival per village. On a sky island there are none: go to the &a&lOverworld Mirror&r&7 (watch the &c&ldimension timer&r&7)"
		"&7&l- &7Or craft a &c&lRival Beacon&r&7 and he comes to &fyou&7, wherever you are"
		"&7&l- &7The &fRadar&7 and the &fWanted Poster&7 tell you where the nearest one prowls"
		""
		"&e&lTHE RULES"
		"&7&l- &7Brackets can be fought in any order. Each one has its own &flevel cap"
		"&7&l- &7Lose, and he grants you &f1 rematch&7 on the spot. Lose that too, and he walks away to heal for &c15 minutes"
		"&7&l- &7He refuses a team that cannot stand: heal first"
		"&7&l- &7The &ffirst&7 clear of a bracket pays a &d&lRival Medal&r&7, PokéDollars and supplies. Later wins only count in the Codex"
		"&7&l- &7Lv. 70, 80 and 90 also unlock &fMega Evolution&7, &fDynamax&7 and &fTerastallization&7"
		""
		"&7&oOnce the ten brackets fall, one last rival appears: Zenith Omega."
	]
	quest.584862F348D76528.quest_subtitle: "&7Ten brackets, one rivalry"
	quest.584862F348D76528.title: "&c&lRival Kyusama"
	quest.5859F79E322B8CF4.quest_desc: ["{quest.unova.description.5}"]
	quest.5859F79E322B8CF4.title: "{quest.unova.title.3}"
	quest.58912420E0F309D2.quest_subtitle: "&7Catch &f&l5&r&7 Legendary Pokémon"
	quest.58912420E0F309D2.title: "&5&lLiving Legend"
	quest.58F99C4C400A3D87.quest_desc: [
		"&d&lS&r&7 is the top of the ladder, and the only rank with &c&lno cap on base stats at all&r&7. Anything in the game can show up, at any size."
		""
		"&e&lPOKEMON"
		"&7Level &f&l80 to 100&r&7. No base stat limit."
		"&c&lLegendary bosses are allowed."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l16&r&7 Pokemon in total"
		"&7&l- &f&l4 to 7&r&7 combat rooms"
		"&7&l- &f&l4&r&7 elite guards"
		"&7&l- &7an &f&lultimate&r&7 tier boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l300&r&7 of &f&l10000&r&7 - &a&l3%&r&7 of all natural Gates, one in &f&l33&r&7."
		""
		"&e&lIN THE CHESTS"
		"&7Sixteen to twenty four Ultra Balls at a time. Beast Balls, Cherish Balls - and the ball pool is rolled &f&lthree times&r&7 per chest, which works out to roughly &d&lone chest in six holding a Master Ball&r&7."
		"&7Full restores, max revives, max elixirs. Eight to twelve rare candies. Ability capsules and &d&lability patches&r&7, comet shards, relic gold, gold bottle caps, PP Max, lucky eggs, exp shares, and &5&lDynamax Candy&r&7."
	]
	quest.58F99C4C400A3D87.quest_subtitle: "&dOne natural Gate in thirty three"
	quest.58F99C4C400A3D87.title: "&d&lRank S"
	quest.5912C4D6FA5D36FC.quest_desc: [
		"&7All &f&l8&r&7 challenges of the &e&lyellow&r&7 row are behind you. The &e&lYellow Trophy&r&7 is yours to put on a shelf."
		""
		"&a&lThe &5&lpurple&a&l row is open."
	]
	quest.5912C4D6FA5D36FC.quest_subtitle: "&7Every yellow challenge, done"
	quest.5912C4D6FA5D36FC.title: "&e&lYellow Trophy"
	quest.598D24569AB5465F.quest_subtitle: "&5Epic"
	quest.59B2F59D0C14B884.quest_desc: [
		"{quest.extended_crafting.description.12}"
		"{quest.extended_crafting.description.3}"
	]
	quest.59D16FCB900F73D3.quest_desc: [
		"&b&lPixelGO Radar&r&7 shows you what is spawning around you before you walk into it."
		""
		"&e&lOPEN THE FILTER"
		"&f&lF4&r&7 by default. Rebind it in Controls, under &7PixelGO - Radar&7."
		""
		"&e&lWHAT IT TRACKS"
		"&7&l- &b&lShiny&r&7 Pokemon"
		"&7&l- &6&lLegendary&r&7 Pokemon"
		"&7&l- &c&lBosses&r&7 and &d&lraids"
		"&7&l- &a&lPalettes&r&7 and special forms"
		"&7&l- &e&lPokeStops and PokeLoot&r&7 chests"
		"&7&l- &7NPCs"
		""
		"&7Search by name, gender, form, Tera type or palette. Turn the compass on and it points the way."
		""
		"&7&oLeave shiny tracking on permanently. It costs nothing and it will save you hours."
	]
	quest.59D16FCB900F73D3.quest_subtitle: "&7See what is out there first"
	quest.59D16FCB900F73D3.title: "&b&lThe Radar"
	quest.5A777FE32A5EB256.quest_desc: [
		"&7Cheap, fast and everywhere: &9Energy Conduits&7, the &bWired Charger&7, the &bDrain&7 and the &bImpulse Hopper&7 all need it."
		""
		"&e&lTip:&r &7Automate it early."
	]
	quest.5A777FE32A5EB256.quest_subtitle: "&7Cheap, fast and everywhere"
	quest.5A777FE32A5EB256.title: "&6&lConductive Alloy"
	quest.5B11C5DCED53DE14.quest_desc: [
		"&6&lEx Deorum&r&7 is the backbone of this pack. Two tools, and the whole periodic table comes out of them."
		""
		"&e&lTHE HAMMER"
		"&7Hold it and break a block by hand. Cobblestone becomes gravel, gravel becomes sand, sand becomes dust."
		""
		"&e&lTHE SIEVE"
		"&7Right click a sieve while holding dirt, gravel, sand or dust. Out come seeds, ores and clay. A sieve does nothing until you put a &a&lmesh&r&7 in it."
		""
		"&e&lMESH LADDER"
		"&f&lString &8> &7&lFlint &8> &f&lIron &8> &6&lGolden &8> &b&lDiamond &8> &8&lNetherite"
		""
		"&7Every mesh unlocks new drops &oand&r&7 improves the odds of everything below it. &c&lSome ores only ever come out of the netherite mesh."
		""
		"&7&oEx Compressum adds an auto hammer and an auto sieve once you have power. You will want both."
	]
	quest.5B11C5DCED53DE14.quest_subtitle: "&7How a skyblock actually works"
	quest.5B11C5DCED53DE14.title: "&6&lSieve and Hammer"
	quest.5B487C51CDBEC57E.quest_desc: [
		"&7Gives a redstone signal when the network holds more, less or exactly the amount of an item you set."
		""
		"&7Recipe in &6JEI&7."
	]
	quest.5B487C51CDBEC57E.quest_subtitle: "&7Redstone from a count"
	quest.5B487C51CDBEC57E.title: "&a&lDetector"
	quest.5B6B08874B2968BF.quest_desc: [
		"&7Send a Pokémon out, wait for the timer, claim the rewards."
		""
		"&7Start with a &fgathering&7 run on &a&lPoké Ball&r&7 difficulty: 10 minutes, any Pokémon, any level."
	]
	quest.5B6B08874B2968BF.quest_subtitle: "&7Complete one expedition"
	quest.5B6B08874B2968BF.title: "&a&lFirst Steps"
	quest.5BA5A4F5BFA6DB3A.quest_desc: ["&7Trade a Pokémon with any of the three traders."]
	quest.5BA5A4F5BFA6DB3A.quest_subtitle: "&7Close a trade with one of the three traders"
	quest.5BA5A4F5BFA6DB3A.title: "&e&lDealmaker"
	quest.5BCA1F7106B27B56.quest_desc: [
		"&7Awarded by &f&lSasuke Uchiha&r&7, &oLightning of the Leaf&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 6&r&7 of 7."
		""
		"&e&lTeam:&r &fCharizard&7, &fHoundoom&7, &fChandelure&7, &fSkeledirge"
		"&7IVs of &f&l28&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l1000&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.5BCA1F7106B27B56.quest_subtitle: "&6Solaris Spire &8- &7Floor 6"
	quest.5BCBE59D89227FB6.quest_subtitle: "&5Epic"
	quest.5BD65EB3A837D11F.quest_desc: [""]
	quest.5C4215FB614F8C3D.quest_desc: [
		"&7The caught Pokémon has &f31 Defence IV&7 — the maximum. IVs cannot be trained away or improved without Hyper Training, so this is permanent perfection on one stat."
		""
		"&e&lTip:&r &7Catch the same species repeatedly with different IV balls and breed the results — the &fDestiny Knot&7 passes five IVs down."
	]
	quest.5C4215FB614F8C3D.quest_subtitle: "&7A perfect 31, guaranteed"
	quest.5C4215FB614F8C3D.title: "&7&lIV Defence Ball"
	quest.5C89D7A569086E8E.quest_desc: [
		"&7Awarded by &f&lSentinel Silvra&r&7, &oTower Guardian&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 2&r&7 of 7."
		""
		"&e&lTeam:&r &fRibombee&7, &fYanmega&7, &fHeracross&7, &fLokix"
		"&7IVs of &f&l12&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l400&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
